# Origin for sort.bunsenbrenner.org. Caddy terminates TLS, serves the static
# visualization page, and reverse-proxies the API surface to the bridge — same shape as
# CADS-a2a-demo's/CADS-auction-demo's Caddyfile (bridge IS the whole API, this file's
# only job is TLS + static file + proxy).
#
# The cert is issued CORE-side (CADS-Tunnel's scripts/authorize-pipeline.sh, deSEC
# DNS-01) and mounted in as static files — never an ACME client or DNS credential here.
#
# While the tunnel is still Gelb (not yet its own Grün cert), the edge terminates TLS
# itself with its shared wildcard cert and forwards PLAINTEXT to the origin — the same
# `auto_https off` + no `tls` directive fix CADS-a2a-demo's/CADS-webconference-demo's
# Caddyfiles already needed for the identical symptom. Switch to
# `tls /certs/fullchain.pem /certs/privkey.pem` once this tunnel reaches Grün.
{
	auto_https off
}

:443 {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}

	@api path /run/* /race /partition /participants /healthz
	reverse_proxy @api sort-demo-bridge:8789

	# Waiting room (CADS-DEMO-sort#9 follow-up): admin routes need a real, Caddy-verified
	# operator identity; the bridge trusts X-Gate-Email absolutely (see server.js's
	# gateVerifiedEmail/requireAdmin) because this is the ONLY place that header is ever set --
	# request_header strips any client-supplied copy BEFORE forward_auth runs, so a smuggled
	# header can never reach the bridge. Mirrors CADS-webconference-demo/Caddyfile's identical
	# block verbatim, including its two hard-won gotchas:
	#   1. route{} is required -- Caddyfile directives execute in Caddy's own implicit priority
	#      order, not textual order, so without route{} the header-strip can run AFTER
	#      forward_auth sets the real value, deleting a legitimate identity instead of just a
	#      spoofed one (live-confirmed against the compiled JSON config upstream).
	#   2. path matchers have no concept of HTTP method -- every matcher below stays as narrow
	#      (exact path, or method+path) as the route it names, so widening one can never
	#      accidentally widen another.
	#
	# 2026-08-13 (auto-approval rework): POST /api/join-requests used to be explicitly EXEMPTED
	# from the gate here (a `@join-submit` matcher + its own public `handle` block) so an
	# anonymous visitor could queue a request for manual admin approval. That's gone -- a real
	# Keycloak login is now what legitimizes a participant (see server.js's
	# handleJoinRequestSubmit), so the submit path falls through to `@gated-api` below like
	# every other join-requests route already did (its path pattern already covered the bare
	# `/api/join-requests`, GET and POST alike -- only POST had a carve-out).
	@channel-info {
		method GET
		path /api/channel-info
	}
	# A participant's own join.js polls its OWN status by "you" id after submitting -- public by
	# design (see handleJoinRequestStatus's own comment: a grant is only usable by whoever holds
	# the matching private key, so reading the grant string itself isn't sensitive). Method+exact-
	# shape matched so this can never accidentally widen to also exempt /approve or /decline
	# (which don't end in /status).
	@join-status {
		method GET
		path /api/join-requests/*/status
	}
	handle @channel-info {
		reverse_proxy sort-demo-bridge:8789
	}
	handle @join-status {
		reverse_proxy sort-demo-bridge:8789
	}

	# A participant removes ITSELF (CADS-DEMO-sort#30) -- public by design, exactly like @join-status:
	# the request body carries a holder-key signature over this deployment's channel, and only
	# whoever holds the private key that created the entry can produce it (see handleParticipantLeave;
	# the bridge re-verifies regardless). Symmetric with the self-service join. Method+shape matched
	# (POST, ends in /leave) so it can never widen to the ADMIN /api/participants/approved/*/revoke
	# route gated below -- different id segment, different suffix.
	@participant-leave {
		method POST
		path /api/participants/*/leave
	}
	handle @participant-leave {
		reverse_proxy sort-demo-bridge:8789
	}

	# Admin-only API routes (list/approve/decline pending join requests, finish admitting a
	# participant) -- gated, then proxied to the bridge, which re-checks X-Gate-Email against
	# SORT_ADMIN_EMAILS itself regardless (never trust the gate alone -- see requireAdmin).
	#
	# Verified live against the real bunsenbrenner.org gate (local Docker test, 2026-08-12): the
	# forward_auth call itself always goes out for real, but whether it actually blocks anyone is
	# a separate, operator-configured toggle on the tunnel itself ("require login" in the portal)
	# -- an unrecognized/ungated host's /gate/check answers 200 with no X-Gate-Email, same
	# documented behavior as CADS-webconference-demo/Caddyfile. Confirmed the bridge's own
	# requireAdmin still correctly 403s in that case (proven: even a client-forged X-Gate-Email
	# header gets stripped before forward_auth runs and never reaches it) -- so the real security
	# boundary is SORT_ADMIN_EMAILS either way, and this Caddy gate is defense-in-depth that only
	# becomes fully effective once the operator turns "require login" on for this tunnel.
	@gated-api {
		path /api/join-requests /api/join-requests/* /api/participants/approved /api/participants/approved/* /api/admin/oidc-session
	}
	handle @gated-api {
		route {
			request_header -X-Gate-Email
			forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
				uri /gate/check
				copy_headers X-Gate-Email
			}
			reverse_proxy sort-demo-bridge:8789
		}
	}

	# admin.html's login form (see admin.js) needs to POST a real OAuth password/refresh-token
	# grant straight to Keycloak, but a same-origin browser fetch from sort.bunsenbrenner.org to
	# auth.bunsenbrenner.org is blocked by CORS -- confirmed live (Keycloak's admin-cli client has
	# no Web-Origins entry for this origin, unlike bunsenbrenner.org's own portal). Rather than
	# routing the password through this bridge's own application code (which would recreate
	# exactly the problem the client-side design exists to avoid -- see docs/operations.md),
	# Caddy proxies the ONE fixed token-endpoint call: the browser stays same-origin (no CORS at
	# all), and this hop only ever forwards opaque request/response bytes -- no server.js code,
	# no logging, nothing here ever parses the body. Gated the same as the rest of the admin
	# surface so an anonymous visitor can't use this bridge as an open relay against Keycloak.
	@gated-oidc-proxy {
		path /api/oidc-proxy/token
	}
	handle @gated-oidc-proxy {
		route {
			request_header -X-Gate-Email
			forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
				uri /gate/check
				copy_headers X-Gate-Email
			}
			rewrite * /realms/ct-demo/protocol/openid-connect/token
			reverse_proxy https://auth.bunsenbrenner.org {
				header_up Host auth.bunsenbrenner.org
			}
		}
	}

	# admin.html itself -- a separate handle block, not folded into @gated-api above, because
	# its downstream action is file_server (a static file), not reverse_proxy: putting both a
	# gate check and file_server in the SAME route{} keeps the required write-order guarantee
	# (see the reverse_proxy-vs-request_header ordering gotcha documented above) without a
	# second gate check ever reaching the bridge for a plain static-file request.
	#
	# 2026-08-13: join.html gets the IDENTICAL treatment -- a real Keycloak login IS the
	# legitimization for becoming a participant now (auto-approval, see server.js's
	# handleJoinRequestSubmit), so an anonymous visitor can no longer even LOAD the join page;
	# forward_auth's own redirect to Keycloak is what an unauthenticated browser sees first.
	@gated-join-page {
		path /join.html
	}
	handle @gated-join-page {
		route {
			request_header -X-Gate-Email
			forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
				uri /gate/check
				copy_headers X-Gate-Email
			}
			root * /srv
			file_server
		}
	}

	# join.js's accurate "logged in as X / auto-approval active" copy. A tiny, ALWAYS-gated
	# endpoint: reaching the bridge handler at all proves forward_auth passed, and the bridge
	# just echoes the verified identity back (see handleWhoami). /api/channel-info itself stays
	# public (non-browser/bootstrap callers need it), so it cannot carry this reliably.
	@whoami {
		path /api/whoami
	}
	handle @whoami {
		route {
			request_header -X-Gate-Email
			forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
				uri /gate/check
				copy_headers X-Gate-Email
			}
			reverse_proxy sort-demo-bridge:8789
		}
	}

	@gated-admin-page {
		path /admin.html
	}
	handle @gated-admin-page {
		route {
			request_header -X-Gate-Email
			forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
				uri /gate/check
				copy_headers X-Gate-Email
			}
			root * /srv
			file_server
		}
	}

	root * /srv
	file_server
}
