node_modules/
participants/*/generated/

# Waiting-room runtime state (SORT_JOIN_REQUESTS_FILE / SORT_PARTICIPANTS_APPROVED_FILE default
# to these relative paths when unset -- real bridge-written data, never source, never committed).
/join-requests.json
/participants-approved.json

# ct-agent-wasm build output (build-wasm.sh) -- generated, not source, same as
# CADS-webconference-demo's own /pkg/ gitignore entry.
/pkg/

# sort-channel-grant's own Rust build output -- vendored source lives in grant/, the built
# binary is produced fresh by bridge/Dockerfile's grant-builder stage, never committed.
/grant/target/

# Same runtime state as /join-requests.json above, but written here when a bridge dev server
# is run from inside bridge/ with a relative SORT_JOIN_REQUESTS_FILE path.
/bridge/join-requests.json
